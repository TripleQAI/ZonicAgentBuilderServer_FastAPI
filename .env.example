# Copy to .env and adjust. Never commit .env.
#
# NOTE: there is deliberately NO database DSN here. This service holds no
# driver, no pool and no credentials — persistence goes through the
# pgfoundation gateway (see deploy/pgfoundation.agentbuilder.yaml).

# --- data access: the pgfoundation gateway -------------------------------
PG_GATEWAY_BASE_URL=http://localhost:8600
PG_GATEWAY_DATASOURCE=agentbuilder
# PostgreSQL schema holding the views and procedures. Sent on every governed
# call, so it does not depend on the connection's search_path.
PG_GATEWAY_SCHEMA=agent_builder
PG_GATEWAY_TIMEOUT_MS=15000
PG_GATEWAY_CONNECT_TIMEOUT_MS=2000
PG_GATEWAY_MAX_RETRIES=2
PG_GATEWAY_AUTH_HEADER=
PG_GATEWAY_PROVIDER=http

# --- service -------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
# Optional. The API serves the JSON registry when node_type_definition is empty,
# so seeding is only needed to push the registry into the database for other
# readers. Turning it on overwrites rows edited there by hand.
SEED_REGISTRY_ON_STARTUP=false

# --- sign-in (the builder's own Cognito user pool) ------------------------
# Every /api/v1 route needs a Cognito ID token of this pool and app client.
# The pool is separate from the Strands Visual Builder's; create it with
# scripts/create-user-pool.sh. AUTH_REQUIRED=false only for local tools.
AUTH_REQUIRED=true
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# --- embedding (AWS Bedrock, Cohere Embed v3) ----------------------------
EMBEDDING_PROVIDER=bedrock
AWS_DEFAULT_REGION=us-east-1
AWS_BEDROCK_REGION=
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_EMBED_MODEL_ID=cohere.embed-english-v3

# --- live integration tests only (pytest -m live) ------------------------
# AGENTBUILDER_TEST_DSN=postgresql://user:pass@localhost:5434/agentworkflowbuilder_test
