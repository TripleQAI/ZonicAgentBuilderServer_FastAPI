# Copy to .env and adjust. Never commit .env.
#
# NOTE: there is deliberately NO database DSN here. This service holds no
# driver, no pool and no credentials — persistence goes through the
# pgfoundation gateway (see deploy/pgfoundation.agentbuilder.yaml).

# --- data access: the pgfoundation gateway -------------------------------
PG_GATEWAY_BASE_URL=http://localhost:8600
PG_GATEWAY_DATASOURCE=agentbuilder
PG_GATEWAY_TIMEOUT_MS=15000
PG_GATEWAY_CONNECT_TIMEOUT_MS=2000
PG_GATEWAY_MAX_RETRIES=2
PG_GATEWAY_AUTH_HEADER=
PG_GATEWAY_PROVIDER=http

# --- service -------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
SEED_REGISTRY_ON_STARTUP=true

# --- embedding (AWS Bedrock, Cohere Embed v3) ----------------------------
EMBEDDING_PROVIDER=bedrock
AWS_DEFAULT_REGION=us-east-1
AWS_BEDROCK_REGION=
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_EMBED_MODEL_ID=cohere.embed-english-v3

# --- live integration tests only (pytest -m live) ------------------------
# AGENTBUILDER_TEST_DSN=postgresql://user:pass@localhost:5434/agentworkflowbuilder_test
