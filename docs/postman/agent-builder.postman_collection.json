      ],
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{TOKEN}}",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "Data gateway (pgfoundation)",
      "description": "Talk to the data layer directly, without this service. Useful for proving the views and procedures work after installing db/.",
      "item": [
        {
          "name": "List datasources",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{GW}}/v1/datasources",
              "host": [
                "{{GW}}"
              ],
              "path": [
                "v1",
                "datasources"
              ]
            },
            "description": "The returned name MUST match {{DS}} and PG_GATEWAY_DATASOURCE. A mismatch surfaces as 502 'unknown data source' from the API."
          },
          "response": []
        },
        {
          "name": "Gateway readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{GW}}/ready",
              "host": [
                "{{GW}}"
              ],
              "path": [
                "ready"
              ]
            },
            "description": "503 when no data source is reachable."
          },
          "response": []
        },
        {
          "name": "Read v_agent_summary",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "content-type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{GW}}/v1/datasources/{{DS}}/view",
              "host": [
                "{{GW}}"
              ],
              "path": [
                "v1",
                "datasources",
                "{{DS}}",
                "view"
              ]
            },
            "description": "Governed read: name a view, pass structured filters. No SQL crosses the wire.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"v_agent_summary\",\n  \"schema\": \"{{SCHEMA}}\",\n  \"order_by\": [\n    {\n      \"column\": \"updated_at\",\n      \"descending\": true\n    }\n  ],\n  \"limit\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
