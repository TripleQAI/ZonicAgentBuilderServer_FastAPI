      "badge": "DB",
      "icon": "bi-database",
      "addLabel": "Add Database Tool",
      "color": "#89b4fa",
      "summary": ["name", "databaseType", "scriptSourceType", "connectionName"],
      "defaults": {
        "toolType": "database",
        "enabled": true,
        "name": "",
        "displayName": "",
        "description": "",
        "databaseType": "mssql",
        "connectionName": "",
        "scriptSourceType": "configured_script",
        "script": "",
        "fireAndForget": false,
        "llmScriptGeneration": {
          "instruction": "",
          "schemaContext": "",
          "allowedTablesOrCollections": [],
          "allowedFieldsOrColumns": [],
          "requiredFilters": [],
          "maxRowLimit": 100
        },
        "approvedTemplateName": "",
        "parameters": [],
        "result": {
          "format": "rows",
          "maxRows": 100,
          "queryTimeout": 30,
          "saveToFlowKey": "",
          "saveToCache": false,
          "cacheKeyConfig": {
            "namespace": { "source": "fixed", "value": "" },
            "cacheType": { "source": "fixed", "value": "" },
            "version": { "source": "fixed", "value": "" },
            "digest": []
          }
        }
      },
      "sections": [
        {
          "fields": [
            {
              "key": "name",
              "label": "Tool Name",
              "type": "text",
              "required": true,
              "unique": true,
              "placeholder": "snake_case_name"
            },
            {
              "key": "displayName",
              "label": "Display Name",
              "type": "text",
              "placeholder": "Human-readable name"
            },
            { "key": "description", "label": "Description", "type": "textarea", "required": true, "rows": 2 },
            {
              "key": "databaseType",
              "label": "Database Type",
              "type": "select",
              "required": true,
              "options": [
                { "value": "mssql", "label": "mssql" },
                { "value": "mysql", "label": "mysql" },
                { "value": "postgresql", "label": "postgresql" },
                { "value": "mongodb", "label": "mongodb" }
              ]
            },
            {
              "key": "connectionName",
              "label": "Connection Name",
              "type": "text",
              "required": true,
              "placeholder": "e.g. bndw_readonly (reference only — no credentials)"
            },
            {
              "key": "scriptSourceType",
              "label": "Script Source",
              "type": "select",
              "required": true,
              "options": [
                { "value": "configured_script", "label": "configured_script" },
                { "value": "llm_generated_script", "label": "llm_generated_script" },
                { "value": "approved_template", "label": "approved_template" }
              ]
            },
            {
              "key": "script",
              "label": "Script",
              "type": "code",
              "required": true,
              "rows": 9,
              "showWhen": { "path": "scriptSourceType", "in": ["configured_script"] }
            },
            {
              "key": "llmScriptGeneration.instruction",
              "label": "LLM Script Instruction",
              "type": "textarea",
              "required": true,
              "rows": 3,
              "placeholder": "Describe what data to query and how.",
              "showWhen": { "path": "scriptSourceType", "in": ["llm_generated_script"] }
            },
            {
              "key": "llmScriptGeneration.schemaContext",
              "label": "Schema Context",
              "type": "textarea",
              "rows": 2,
              "placeholder": "Paste relevant table / column schema here.",
              "showWhen": { "path": "scriptSourceType", "in": ["llm_generated_script"] }
            },
            {
              "key": "llmScriptGeneration.allowedTablesOrCollections",
              "label": "Allowed Tables / Collections",
              "type": "string_list",
              "placeholder": "e.g. BNDW.Utility.bill",
              "showWhen": { "path": "scriptSourceType", "in": ["llm_generated_script"] }
            },
            {
              "key": "llmScriptGeneration.allowedFieldsOrColumns",
              "label": "Allowed Fields / Columns",
              "type": "string_list",
              "placeholder": "e.g. BillSk, FacilitySk",
              "showWhen": { "path": "scriptSourceType", "in": ["llm_generated_script"] }
            },
            {
              "key": "llmScriptGeneration.requiredFilters",
              "label": "Required Filters",
              "type": "string_list",
              "placeholder": "e.g. ClientCode = <CLIENT_CODE>",
              "showWhen": { "path": "scriptSourceType", "in": ["llm_generated_script"] }
            },
            {
              "key": "llmScriptGeneration.maxRowLimit",
              "label": "Max Row Limit",
              "type": "number",
              "min": 1,
              "max": 10000,
              "showWhen": { "path": "scriptSourceType", "in": ["llm_generated_script"] }
            },
            {
              "key": "approvedTemplateName",
              "label": "Template Name",
              "type": "select",
              "required": true,
              "placeholder": "-- select template --",
              "showWhen": { "path": "scriptSourceType", "in": ["approved_template"] },
              "options": [
                { "value": "bill_details_by_period", "label": "bill_details_by_period" },
                { "value": "bill_summary_by_period", "label": "bill_summary_by_period" },
                { "value": "missing_bills_by_period", "label": "missing_bills_by_period" },
                { "value": "usage_variance_by_period", "label": "usage_variance_by_period" },
                { "value": "mongodb_bill_details_by_period", "label": "mongodb_bill_details_by_period" }
              ]
            }
          ]
        },
        {
          "title": "Dynamic Parameter Mapping",
          "fields": [{ "key": "parameters", "type": "parameter_list" }]
        },
        {
          "title": "Tool Result Settings",
          "fields": [
            {
              "key": "result.format",
              "label": "Result Format",
              "type": "select",
              "options": [
                { "value": "rows", "label": "rows" },
                { "value": "single_object", "label": "single_object" },
                { "value": "summary", "label": "summary" },
                { "value": "raw", "label": "raw" }
              ]
            },
            { "key": "result.maxRows", "label": "Max Result Rows", "type": "number", "min": 1, "max": 10000 },
            { "key": "result.queryTimeout", "label": "Query Timeout (s)", "type": "number", "min": 5, "max": 600 },
            {
              "key": "result.saveToFlowKey",
              "label": "Save Result To Flow Key",
              "type": "text",
              "placeholder": "e.g. flow.queryResponse"
            },
            { "key": "result.saveToCache", "label": "Save result in cache", "type": "switch" },
            {
              "key": "result.cacheKeyConfig",
              "type": "cache_key_config",
              "showWhen": { "path": "result.saveToCache", "in": [true] }
            }
          ]
        },
        {
          "fields": [{ "key": "fireAndForget", "label": "Enable fire-and-forget", "type": "switch" }]
        }
      ]
    },

