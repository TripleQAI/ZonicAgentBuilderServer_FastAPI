{
  "type": "llm",
  "label": "LLM",
  "icon": "bi-cpu-fill",
  "color": "#3b82f6",
  "description": "Calls a large language model with a prompt.",
  "defaultNamePrefix": "LLM",
  "defaultData": {
    "label": "LLM"
  },
  "defaultConfig": {
    "model": "claude-sonnet-4-6",
    "messages": [],
    "tools": [],
    "responseFormat": "text",
    "temperature": 0.7,
    "maxTokens": 1024,
    "errorHandling": false,
    "stateUpdates": [],
    "outputSchema": [],
    "variableUpdates": []
  },
  "handles": {
    "sources": [
      {
        "id": "default",
        "position": "bottom",
        "label": ""
      }
    ],
    "targets": [
      {
        "id": "default",
        "position": "top",
        "label": ""
      }
    ]
  },
  "formSchema": {
    "sections": [
      {
        "title": "Definition",
        "fields": [
          {
            "key": "config.model",
            "label": "Model",
            "type": "select",
            "required": true,
            "options": {
              "$ref": "options.models"
            },
            "defaultValue": "claude-sonnet-4-6"
          }
        ]
      },
      {
        "title": "Instructions",
        "fields": [
          {
            "key": "config.messages",
            "label": "Messages",
            "type": "message_list"
          }
        ]
      },
      {
        "title": "Tools",
        "fields": [
          {
            "key": "config.tools",
            "label": "Tools",
            "type": "tool_list"
          }
        ]
      },
      {
        "$ref": "section.output_structure"
      },
      {
        "$ref": "section.variable_updates"
      },
      {
        "type": "accordion",
        "label": "Advanced",
        "defaultOpen": false,
        "fields": [
          {
            "key": "config.responseFormat",
            "label": "Response Format",
            "type": "select",
            "options": [
              {
                "value": "text",
                "label": "Plain Text"
              },
              {
                "value": "json",
                "label": "JSON Object"
              }
            ],
            "defaultValue": "text"
          },
          {
            "key": "config.temperature",
            "label": "Temperature",
            "type": "number",
            "min": 0,
            "max": 2,
            "step": 0.1,
            "defaultValue": 0.7
          },
          {
            "key": "config.maxTokens",
            "label": "Max Tokens",
            "type": "number",
            "defaultValue": 1024
          },
          {
            "key": "config.errorHandling",
            "label": "Enable Error Handling",
            "type": "switch",
            "defaultValue": false
          }
        ]
      }
    ]
  },
  "outputSchema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string"
      }
    }
  },
  "validationRules": [
    "required_name"
  ],
  "sortOrder": 2
}
